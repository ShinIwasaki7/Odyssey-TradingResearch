{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PutOnlyIntoProbeTempBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::odyssey-mt5-probe-*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1"
        }
      }
    }
  ]
}
